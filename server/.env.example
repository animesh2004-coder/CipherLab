# ============================================================================
# CipherLab Server – Environment Variables
# Copy to .env and fill in real values. NEVER commit .env to version control.
# ============================================================================

# --- Required ---

# Application environment
NODE_ENV=development

# Server port
PORT=3001

# PostgreSQL connection string
# For local Docker: postgresql://cipherlab_dev:cipherlab_dev_pass@localhost:5432/cipherlab
DATABASE_URL=postgresql://cipherlab_dev:cipherlab_dev_pass@localhost:5432/cipherlab

# Redis connection string
# For local Docker: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# Session signing secret – MUST be at least 32 characters
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=CHANGE_ME_generate_a_random_secret_at_least_32_chars

# OIDC Provider configuration
OIDC_ISSUER_URL=https://your-oidc-provider.example.com
OIDC_CLIENT_ID=your-client-id
OIDC_CLIENT_SECRET=your-client-secret
OIDC_REDIRECT_URI=http://localhost:3001/api/auth/callback

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Optional ---

# Logging level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# OIDC scopes (space-separated)
# OIDC_SCOPES=openid profile email

# Session max age in seconds (default: 86400 = 24 hours)
# SESSION_MAX_AGE_SECONDS=86400

# Rate limiting
# RATE_LIMIT_MAX=100
# RATE_LIMIT_WINDOW_MS=60000

# Request body size limit
# REQUEST_BODY_LIMIT=1mb

# Cookie domain (omit for default; set for cross-subdomain)
# COOKIE_DOMAIN=.example.com

# Trust proxy headers (set true behind a reverse proxy / load balancer)
# TRUST_PROXY=false
